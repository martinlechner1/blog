---
import { getCollection, render } from "astro:content"
import Base from "../layouts/Base.astro"
import { formatDate } from "../site"

const books = await Promise.all(
  (await getCollection("books", book => !book.data.draft))
    .sort(
      (a, b) =>
        b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title)
    )
    .map(async book => ({ ...book, Content: (await render(book)).Content }))
)
---

<Base
  title="Books"
  description="Books Martin Lechner enjoyed reading, with a short review of each."
>
  <h1>Books</h1>
  <p class="lede">A collection of books I quite enjoyed reading, each with a few words on why.</p>

  <div class="books">
    {books.map(({ data, Content }) => (
      <article class="book">
        <h2>{data.title}</h2>
        <p class="author">{data.author}</p>
        <div class="review">
          <Content />
        </div>
        <p class="meta">
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time> · {data.category}
        </p>
      </article>
    ))}
  </div>
</Base>

<style>
  .books {
    display: grid;
    gap: 1rem;
  }

  .book {
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 4px 10px 10px 4px;
    background: var(--bg-subtle);
  }

  .book h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    letter-spacing: 0;
    margin: 0;
  }

  .author {
    margin: 0.15rem 0 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .review {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
  }

  .review > :global(:last-child) {
    margin-bottom: 0;
  }

  .book .meta {
    margin: 0.75rem 0 0;
  }
</style>
