---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import Base from "../layouts/Base.astro"
import PostList from "../components/PostList.astro"
import profilePic from "../assets/profile-pic.jpg"
import { SITE, SOCIAL } from "../site"

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
const talks = (await getCollection("talks")).sort((a, b) => a.data.order - b.data.order).slice(0, 3)
const bookCount = (await getCollection("books", book => !book.data.draft)).length
---

<Base>
  <section class="intro">
    <Image
      src={profilePic}
      alt="Portrait of Martin Lechner"
      width={112}
      height={112}
      densities={[1, 2]}
      class="avatar"
      loading="eager"
    />
    <div>
      <h1>Martin Lechner</h1>
      <p class="role">Developer Experience at Personio</p>
    </div>
  </section>

  <p class="lede">
    I work on developer experience at Personio and care a lot about people, tech, AI agents,
    photography and good coffee. Previously at Twitter&nbsp;1.0, AutoScout24 and Jambit.
  </p>

  <ul class="contact">
    <li>
      <a href={SOCIAL.linkedIn}>LinkedIn</a>
    </li>
    <li>
      <a href={SOCIAL.github}>GitHub</a>
    </li>
    <li>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </li>
  </ul>

  <div class="section-head">
    <h2>Writing</h2>
    <a href="/blog/">All posts →</a>
  </div>
  <PostList posts={posts} />

  <div class="section-head">
    <h2>Talks</h2>
    <a href="/talks/">All talks →</a>
  </div>
  <ul class="entries">
    {talks.map(({ data }) => (
      <li>
        <h3>
          <a href={data.links[0].url}>{data.title}</a>
        </h3>
        <span class="meta">{data.kind}</span>
      </li>
    ))}
  </ul>

  <a class="books-card" href="/books/">
    <span class="eyebrow">Reading</span>
    <strong>Books worth your time</strong>
    <span class="muted">
      {bookCount} short reviews on leadership, communication and engineering →
    </span>
  </a>
</Base>

<style>
  .intro {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .avatar {
    border-radius: 50%;
    flex-shrink: 0;
    width: 112px;
    height: 112px;
    object-fit: cover;
  }

  .intro h1 {
    margin: 0;
  }

  .role {
    margin: 0.25rem 0 0;
    color: var(--text-muted);
    font-weight: 500;
  }

  .lede {
    margin-bottom: 1.5rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .contact a {
    display: inline-block;
    font-size: 0.9375rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
  }

  .contact a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .books-card {
    display: grid;
    gap: 0.25rem;
    margin-top: 3.5rem;
    padding: 1.5rem;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--text);
    text-decoration: none;
  }

  .books-card strong {
    font-family: var(--font-serif);
    font-size: 1.375rem;
  }

  .books-card:hover strong {
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    .intro {
      gap: 1rem;
    }
    .avatar {
      width: 80px;
      height: 80px;
    }
  }
</style>
